# Database (Local PostgreSQL via Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/disaster_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=disaster_db
POSTGRES_PORT=5432

# Backend Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=7d

# CORS & Network
# In local development, specify dashboard URL (e.g. http://localhost:5173) and/or LAN IP
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Mobile (For Expo development)
# Use your laptop's Wi-Fi / LAN IP (e.g., http://192.168.1.100:4000) or Android Emulator (http://10.0.2.2:4000)
EXPO_PUBLIC_API_URL=http://localhost:4000
