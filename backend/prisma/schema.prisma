generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         String     @default("citizen") // 'citizen' | 'volunteer' | 'authority' | 'admin'
  lat          Float?
  lng          Float?
  available    Boolean    @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  incidents    Incident[] @relation("UserIncidents")
  tasks        Task[]     @relation("VolunteerTasks")
  alerts       Alert[]    @relation("UserAlerts")

  @@map("users")
}

model Incident {
  id          String   @id @default(uuid())
  reporterId  String?
  reporter    User?    @relation("UserIncidents", fields: [reporterId], references: [id], onDelete: SetNull)
  type        String
  description String
  severity    String   @default("medium") // 'low' | 'medium' | 'high' | 'critical'
  status      String   @default("pending") // 'pending' | 'assigned' | 'in_progress' | 'resolved' | 'rejected'
  lat         Float
  lng         Float
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media       Media[]
  tasks       Task[]

  @@map("incidents")
}

model Media {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  path       String
  createdAt  DateTime @default(now())

  @@map("media")
}

model Task {
  id          String    @id @default(uuid())
  incidentId  String
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  volunteerId String
  volunteer   User      @relation("VolunteerTasks", fields: [volunteerId], references: [id], onDelete: Cascade)
  status      String    @default("assigned") // 'assigned' | 'enroute' | 'reached' | 'resolved'
  assignedAt  DateTime  @default(now())
  resolvedAt  DateTime?

  @@map("tasks")
}

model Resource {
  id        String   @id @default(uuid())
  type      String
  quantity  Int
  lat       Float?
  lng       Float?
  status    String   @default("available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resources")
}

model Shelter {
  id        String   @id @default(uuid())
  name      String
  lat       Float
  lng       Float
  capacity  Int
  occupancy Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shelters")
}

model Alert {
  id        String   @id @default(uuid())
  message   String
  region    String?
  severity  String   @default("high") // 'low' | 'medium' | 'high' | 'critical'
  channel   String   @default("socket") // 'inapp' | 'socket' | 'sms_mock'
  createdBy String?
  creator   User?    @relation("UserAlerts", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("alerts")
}
